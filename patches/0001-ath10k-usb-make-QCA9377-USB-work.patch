diff --git a/drivers/net/wireless/ath/ath10k/htt.c b/drivers/net/wireless/ath/ath10k/htt.c
index dbaf262..d62d4b3 100644
--- a/drivers/net/wireless/ath/ath10k/htt.c
+++ b/drivers/net/wireless/ath/ath10k/htt.c
@@ -317,7 +317,11 @@ int ath10k_htt_connect(struct ath10k_htt *htt)
 	}
 
 	htt->disable_tx_comp = ath10k_hif_get_htt_tx_complete(htt->ar);
-	if (htt->disable_tx_comp)
+	/* USB: local TX completion, but no HTC credit flow on the data endpoint.
+	 * It starts with zero credits and the firmware returns them very rarely,
+	 * which limited TX to about one frame every 3 seconds.
+	 */
+	if (htt->disable_tx_comp && ar->hif.bus != ATH10K_BUS_USB)
 		ath10k_htc_change_tx_credit_flow(&htt->ar->htc, htt->eid, true);
 
 	return 0;
