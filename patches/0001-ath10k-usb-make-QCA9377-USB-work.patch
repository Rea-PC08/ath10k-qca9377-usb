+/* The QCA9377 USB firmware never sends HTT_T2H_MSG_TYPE_TX_COMPL_IND, so TX
+ * completion is done locally when the USB transfer completes. Without this
+ * the pending TX count fills up and the link freezes after a few packets.
+ */
+static int ath10k_usb_get_htt_tx_complete(struct ath10k *ar)
+{
+	return 1;
+}
+
 static const struct ath10k_hif_ops ath10k_usb_hif_ops = {
 	.tx_sg			= ath10k_usb_hif_tx_sg,
 	.diag_read		= ath10k_usb_hif_diag_read,
@@ -735,6 +744,7 @@ static const struct ath10k_hif_ops ath10k_usb_hif_ops = {
 	.map_service_to_pipe	= ath10k_usb_hif_map_service_to_pipe,
 	.get_default_pipe	= ath10k_usb_hif_get_default_pipe,
 	.get_free_queue_number	= ath10k_usb_hif_get_free_queue_number,
+	.get_htt_tx_complete	= ath10k_usb_get_htt_tx_complete,
 	.power_up		= ath10k_usb_hif_power_up,
 	.power_down		= ath10k_usb_hif_power_down,
 #ifdef CONFIG_PM
